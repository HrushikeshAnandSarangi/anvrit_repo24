capture_directory: "~"
fixed_frame: odom  # Set to odom since we are transforming GPS data into odom frame
target_frame: base_footprint  # As per your TF setup
fix_orientation: false
rotate_90: false
enable_antialiasing: true
show_displays: true
show_status_bar: true
show_capture_tools: true
window_width: 1920
window_height: 1016
view_scale: 0.564473748
offset_x: -55.0469894
offset_y: -4.65194941
use_latest_transforms: true
background: "#a0a0a4"
image_transport: raw
displays:
  - type: mapviz_plugins/tile_map
    name: new display
    config:
      visible: true
      collapsed: false
      custom_sources:
        - name: OSM_Tiles
          url: "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
          subdomains: "abc"
      source: OSM_Tiles
  - type: mapviz_plugins/point_click_publisher
    name: new display
    config:
      visible: true
      collapsed: false
      topic: clicked_point
      output_frame: wgs84  # GPS data is in wgs84; adjust based on your use case
  - type: mapviz_plugins/tf_frame
    name: new display
    config:
      visible: true
      collapsed: false
      frame: base_footprint  # Frame to visualize (local robot frame)
      color: "#00ff00"
      draw_style: arrows
      position_tolerance: 0.1
      buffer_size: 10
      static_arrow_sizes: true
      arrow_size: 53
  - type: mapviz_plugins/navsat
    name: new display
    config:
      visible: true
      collapsed: false
      topic: /gps/fix  # GPS data
      color: "#55aaff"
      draw_style: points
      position_tolerance: 0
      buffer_size: 1
      output_frame: odom  # Set output frame to odom (to match the frame of the robot)
